Thumbs.db

# Large binary files (add specific exceptions as needed)
*.npy
*.tif
*.tiff
*.png
*.gif
*.jpg
*.jpeg

# Keep specific validation/benchmark files
!_validation/**/*.npy
!_validation/**/*.tif
!_validation/**/*.png
!_validation/**/*.gif

# Docs figures are deliverables: track them despite the global *.png ignore
!docs/images/*.png

# Experimentation / scratch work — not part of the package
_dev/

# Serena MCP tool scaffolding
.serena/

# Git worktrees for isolated feature work
.worktrees/
